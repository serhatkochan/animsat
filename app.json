{
  "expo": {
    "name": "Anımsat",
    "slug": "animsat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "animsat",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.animsat.app",
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "remote-notification"
        ],
